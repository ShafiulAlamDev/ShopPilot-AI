[mysqld]
# =============================================================================
# MySQL 8 configuration — ShopPilot AI
# =============================================================================

# --- Character set ---
character-set-server  = utf8mb4
collation-server      = utf8mb4_unicode_ci

# --- Performance ---
innodb_buffer_pool_size    = 256M
innodb_log_file_size       = 64M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method        = O_DIRECT

# --- Query cache (disabled in MySQL 8 — use Redis) ---
# query_cache_type = 0

# --- Slow query log ---
slow_query_log         = 1
slow_query_log_file    = /var/lib/mysql/slow.log
long_query_time        = 2

# --- Connection ---
max_connections        = 200
wait_timeout           = 600
interactive_timeout    = 600

# --- Binary logging (required for replication / point-in-time recovery) ---
log_bin                = mysql-bin
binlog_format          = ROW
expire_logs_days       = 7

# --- JSON / full-text ---
ft_min_word_len        = 3

[client]
default-character-set  = utf8mb4

[mysql]
default-character-set  = utf8mb4
