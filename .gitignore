# =============================================================================
# ShopPilot AI — Root .gitignore
# =============================================================================

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Node
node_modules/

# Next.js
frontend/.next/
frontend/out/

# Laravel
api/vendor/
api/storage/logs/*.log
api/storage/framework/sessions/
api/storage/framework/views/
api/storage/framework/cache/data/
api/bootstrap/cache/*.php
api/.phpunit.result.cache

# Docker volumes / SSL certs
docker/nginx/ssl/
docker/mysql/data/

# OS
.DS_Store
Thumbs.db
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
